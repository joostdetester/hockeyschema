BASE_URL=https://playwright.dev
# Firestore REST API base for the target environment's Firebase project
# (trailing slash required). e.g.
# https://firestore.googleapis.com/v1/projects/hockeyschema-test/databases/(default)/documents/
API_BASE_URL=https://firestore.googleapis.com/v1/projects/hockeyschema-test/databases/(default)/documents/
# Dedicated test account for this environment - a coach (or admin) linked to
# a real team there. Used by the "logged in as a team member" step. Never a
# real person's own credentials.
USER_EMAIL=
USER_PASSWORD=
