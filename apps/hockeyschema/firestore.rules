rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return request.auth != null && me().role == 'admin'; }
    function isTeamMember(teamId) { return request.auth != null && (me().teamId == teamId || isAdmin()); }

    match /teams/{teamId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /teams/{teamId}/state/public {
      allow read: if true;
      allow write: if isTeamMember(teamId);
    }
    match /teams/{teamId}/state/history {
      allow read: if isTeamMember(teamId);
      allow write: if isTeamMember(teamId);
    }
    match /teams/{teamId}/config/lisa {
      allow read: if isTeamMember(teamId);
      allow write: if isTeamMember(teamId);
    }
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      // Admin can change anything; a user may additionally touch their own doc, but only
      // the logins field (recording their own successful sign-ins) - not teamId/role/email.
      allow write: if isAdmin() || (
        request.auth != null && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['logins'])
      );
    }
    match /settings/app {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
