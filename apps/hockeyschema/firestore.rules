rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return request.auth != null && me().role == 'admin'; }
    // A coach/manager can belong to several teams at once, each with its own role, stored in
    // the `teams` map. Falls back to the legacy single teamId/role pair for an account not yet
    // touched by the current addCoachToTeam (which migrates a doc to the map shape the next
    // time it's (re)linked to a team).
    function roleFor(teamId) {
      return ('teams' in me()) && (teamId in me().teams) ? me().teams[teamId]
        : (me().teamId == teamId ? me().role : null);
    }
    // isTeamMember: coach (or admin) of this team - deliberately excludes 'manager', who only
    // gets the narrower write rule below on state/public (fixtures, for the Ouders indeling).
    function isTeamMember(teamId) { return request.auth != null && ((roleFor(teamId) != null && roleFor(teamId) != 'manager') || isAdmin()); }
    function isManager(teamId) { return request.auth != null && roleFor(teamId) == 'manager'; }

    match /teams/{teamId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /teams/{teamId}/state/public {
      allow read: if true;
      // A manager may only ever touch the fixtures field (Pauzehap/rijden per wedstrijd) -
      // never players/sc/match/standings, which stay coach/admin-only via isTeamMember.
      allow write: if isTeamMember(teamId)
        || (isManager(teamId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fixtures']));
    }
    match /teams/{teamId}/state/history {
      allow read: if isTeamMember(teamId);
      allow write: if isTeamMember(teamId);
    }
    match /teams/{teamId}/config/lisa {
      allow read: if isTeamMember(teamId);
      allow write: if isTeamMember(teamId);
    }
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      // Admin can change anything; a user may additionally touch their own doc, but only
      // the logins field (recording their own successful sign-ins) - not teamId/role/email.
      allow write: if isAdmin() || (
        request.auth != null && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['logins'])
      );
    }
    match /settings/app {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
